<aura:component controller="AladinHomePageComponentController"
                description="Related list of book page"
                implements="force:appHostable,flexipage:availableForAllPageTypes,force:hasRecordId"
                access="global">

    <aura:handler name="init" value="{!this}" action="{!c.fnInit}" />
    <aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="listBook" type="Object"/>
    <aura:attribute name="bookColumns" type="List"/>

    <body>
        <lightning:datatable
                data="{!v.listBook}"
                columns="{!v.bookColumns}"
                keyField="id"/>
    </body>
	
</aura:component>