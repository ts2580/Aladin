<aura:component controller="AladinHomePageComponentController"
                description="BranchBookRefreshButton"
                implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome"
                access="global">

    <!-- 노티피케이션 -->
    <lightning:notificationsLibrary aura:id="notificationLib"/>

    <!-- 스피너 -->
    <aura:attribute name="isSpinnerOpen"            type="boolean"          default="false"/>

    <!--수동 작업용-->
    <aura:attribute name="isFirstTry"               type="boolean"          default="true"/>
    <aura:attribute name="tryNum"                   type="Integer"          default="2"/>
    <aura:attribute name="startNum"                 type="Integer"          default="1"/>
    <aura:attribute name="endNum"                   type="Integer"          default="30"/>

    <!--스피너-->
    <aura:if isTrue="{!v.isSpinnerOpen}">
        <div role="status" class="slds-spinner slds-spinner_large slds-spinner_brand" style="position:relative">
            <span class="slds-assistive-text">생성중</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
        </div>
    </aura:if>
    <div class="slds-box_x-small slds-theme_shade slds-clearfix slds-border_top slds-border_right slds-border_left slds-border_bottom">
        <div class="slds-grid slds-gutters">
            <div class="slds-col slds-size_6-of-12">
                <div class="slds-float_left">
                    <lightning:card iconName="standard:knowledge" title="지점별 재고 자동 갱신" class="slds-theme_shade">
                    </lightning:card>
                </div>
            </div>
            <div class="slds-col slds-size_6-of-12">
                <div class="slds-float_right">
                    <lightning:buttonGroup>
                        <lightning:button label="지점별 재고 새로고침" onclick="{!c.refreshBooks_1}"/>
                        <lightning:button label="실패한 인터페이스 재실행" onclick="{!c.rerun}"/>
                        <lightning:button label="지점별 총액 새로고침" onclick="{!c.refreshPrices}"/>
                    </lightning:buttonGroup>
                </div>
            </div>
        </div>
    </div>

    <div class="slds-box_x-small slds-theme_shade slds-clearfix slds-border_top slds-border_right slds-border_left slds-border_bottom slds-m-top_medium">
        <div class="slds-grid slds-gutters">
            <div class="slds-col slds-size_3-of-12">
                <div class="slds-float_left">
                    <lightning:card iconName="standard:knowledge" title="지점별 재고수동 갱신" class="slds-theme_shade">
                    </lightning:card>
                </div>
            </div>
            <div class="slds-col slds-size_9-of-12">
                <div class="slds-float_right">
                    <div class="slds-grid slds-gutters">
                        <div class="slds-col slds-size_4-of-12">
                            <lightning:input
                                    label="시작 Seq"
                                    variant="label-hidden"
                                    value="{!v.startNum}"
                                    class="slds-align_absolute-center"
                            >
                            </lightning:input>
                        </div>
                        <div class="slds-col slds-size_4-of-12">
                            <lightning:input
                                    label="종료 Seq"
                                    variant="label-hidden"
                                    value="{!v.endNum}"
                                    class="slds-align_absolute-center"
                            >
                            </lightning:input>
                        </div>
                        <div class="slds-col slds-size_4-of-12">
                            <lightning:button label="시작" onclick="{!c.fnDoManualIf}"></lightning:button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</aura:component>